<Window x:Class="JustDjvu.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки JustDjVu"
        Width="820" Height="610" MinWidth="720" MinHeight="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Общие">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Язык интерфейса" VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Margin="0,6" Width="230"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Russian" Content="Русский"/>
                        <ComboBoxItem Tag="English" Content="English"/>
                        <ComboBoxItem Tag="German" Content="Deutsch"/>
                        <ComboBoxItem Tag="French" Content="Français"/>
                        <ComboBoxItem Tag="Spanish" Content="Español"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="Тема интерфейса" VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" Margin="0,6" Width="230"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Light" Content="Светлая"/>
                        <ComboBoxItem Tag="Dark" Content="Тёмная"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Режим просмотра по умолчанию"
                               VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox x:Name="ViewModeCombo" Grid.Row="2" Grid.Column="1" Margin="0,6"
                              Width="230" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Single" Content="Одна страница"/>
                        <ComboBoxItem Tag="Continuous" Content="Непрерывно"/>
                        <ComboBoxItem Tag="Facing" Content="Разворот"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Text="Размер страницы по умолчанию"
                               VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox x:Name="ZoomModeCombo" Grid.Row="3" Grid.Column="1" Margin="0,6"
                              Width="230" HorizontalAlignment="Left"
                              SelectionChanged="ZoomModeCombo_SelectionChanged">
                        <ComboBoxItem Tag="FitPage" Content="Вместить страницу"/>
                        <ComboBoxItem Tag="FitWidth" Content="По ширине"/>
                        <ComboBoxItem Tag="ActualSize" Content="Реальный размер (100%)"/>
                        <ComboBoxItem Tag="Custom" Content="Свой масштаб"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Свой масштаб" VerticalAlignment="Center" Margin="0,8"/>
                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,6" Width="300"
                               HorizontalAlignment="Left">
                        <TextBlock x:Name="DefaultZoomLabel" DockPanel.Dock="Right" Width="55"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="DefaultZoomSlider" Minimum="10" Maximum="400"
                                TickFrequency="10" ValueChanged="DefaultZoomSlider_ValueChanged"/>
                    </DockPanel>

                    <TextBlock Grid.Row="5" Text="Элементы интерфейса"
                               VerticalAlignment="Top" Margin="0,10"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,7">
                        <CheckBox x:Name="ReopenLastDocumentCheck"
                                  Content="Открывать последний документ при запуске" Margin="0,3,0,7"/>
                        <CheckBox x:Name="ShowSidebarCheck" Content="Показывать боковую панель" Margin="0,3"/>
                        <CheckBox x:Name="ShowToolbarCheck" Content="Показывать панель инструментов" Margin="0,7,0,3"/>
                    </StackPanel>

                    <Border Grid.Row="6" Grid.ColumnSpan="2" Margin="0,24,0,0"
                            Padding="14" CornerRadius="6"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Настройки сохраняются отдельно для текущего пользователя. Размер окна и положение полос прокрутки Windows восстанавливает автоматически."/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Горячие клавиши">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Щёлкните сочетание и нажмите клавиши или прокрутите колесо мыши."
                               Foreground="{DynamicResource MutedTextBrush}" Margin="4,2,4,10"/>
                    <DataGrid x:Name="HotkeysGrid" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource PanelBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Действие" Binding="{Binding Title}"
                                                Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Основное" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PrimaryGesture}" IsReadOnly="True"
                                                 Tag="Primary"
                                                 Cursor="Hand" Margin="3"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 PreviewMouseWheel="HotkeyBox_PreviewMouseWheel"
                                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Дополнительное" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SecondaryGesture}" IsReadOnly="True"
                                                 Tag="Secondary"
                                                 Cursor="Hand" Margin="3"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 PreviewMouseWheel="HotkeyBox_PreviewMouseWheel"
                                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Сбросить всё"
                                Click="ResetHotkeys_Click"/>
                        <TextBlock x:Name="HotkeyHint" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Esc — отменить ввод"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Сохранить" Width="110" Style="{StaticResource AccentButton}"
                    Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
