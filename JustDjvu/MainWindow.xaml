<Window x:Class="JustDjvu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JustDjvu"
        mc:Ignorable="d"
        Title="JustDjVu"
        Width="1220" Height="780" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SidebarList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ToolbarRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenu" Grid.Row="0">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть…" Click="Open_Click" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="RecentMenu" Header="Недавние файлы"
                          SubmenuOpened="RecentMenu_SubmenuOpened"/>
                <Separator/>
                <MenuItem Header="Сохранить _копию…" Click="SaveCopy_Click"/>
                <MenuItem Header="_Экспорт страницы в PNG…" Click="ExportPage_Click"/>
                <MenuItem Header="_Печать страницы…" Click="Print_Click" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="_Закрыть документ" Click="CloseDocument_Click" InputGestureText="Ctrl+W"/>
                <MenuItem Header="Вы_ход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="_Копировать страницу" Click="CopyPage_Click"/>
                <MenuItem Header="_Найти…" Click="FocusSearch_Click" InputGestureText="Ctrl+F"/>
                <MenuItem Header="_Закладка на странице" Click="ToggleBookmark_Click" InputGestureText="Ctrl+B"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem x:Name="SidebarMenuItem" Header="_Боковая панель" IsCheckable="True"
                          Click="ToggleSidebar_Click"/>
                <MenuItem x:Name="ToolbarMenuItem" Header="Панель _инструментов" IsCheckable="True"
                          Click="ToggleToolbar_Click"/>
                <Separator/>
                <MenuItem x:Name="SingleModeMenuItem" Header="_Одна страница" IsCheckable="True"
                          Click="SingleMode_Click"/>
                <MenuItem x:Name="ContinuousModeMenuItem" Header="_Непрерывно" IsCheckable="True"
                          Click="ContinuousMode_Click"/>
                <MenuItem x:Name="FacingModeMenuItem" Header="_Разворот" IsCheckable="True"
                          Click="FacingMode_Click"/>
                <Separator/>
                <MenuItem Header="Вместить _страницу" Click="FitPage_Click" InputGestureText="F"/>
                <MenuItem Header="По _ширине" Click="FitWidth_Click" InputGestureText="W"/>
                <MenuItem Header="_Реальный размер" Click="ActualSize_Click" InputGestureText="Ctrl+0"/>
                <MenuItem Header="_Увеличить" Click="ZoomIn_Click"/>
                <MenuItem Header="У_меньшить" Click="ZoomOut_Click"/>
                <Separator/>
                <MenuItem Header="_Повернуть по часовой" Click="Rotate_Click" InputGestureText="Ctrl+R"/>
                <MenuItem x:Name="DarkThemeMenuItem" Header="_Тёмная тема" IsCheckable="True"
                          Click="ToggleTheme_Click"/>
                <MenuItem Header="Полный _экран" Click="FullScreen_Click" InputGestureText="F11"/>
            </MenuItem>
            <MenuItem Header="_Переход">
                <MenuItem Header="_Первая страница" Click="FirstPage_Click" InputGestureText="Home"/>
                <MenuItem Header="_Предыдущая страница" Click="PreviousPage_Click" InputGestureText="←"/>
                <MenuItem Header="_Следующая страница" Click="NextPage_Click" InputGestureText="→"/>
                <MenuItem Header="П_оследняя страница" Click="LastPage_Click" InputGestureText="End"/>
            </MenuItem>
            <MenuItem Header="_Инструменты">
                <MenuItem Header="_Настройки…" Click="Settings_Click"/>
                <MenuItem Header="Зарегистрировать для ._djvu" Click="RegisterAssociation_Click"/>
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_Горячие клавиши" Click="ShortcutsHelp_Click"/>
                <MenuItem Header="_О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border x:Name="ToolbarHost" Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ToolBar x:Name="MainToolbar" Height="48" Padding="8,5" Band="0"
                     ToolBarTray.IsLocked="True">
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Открыть документ"
                        Click="Open_Click" Content="📂"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Сохранить копию"
                        Click="SaveCopy_Click" Content="💾"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Печать"
                        Click="Print_Click" Content="🖨"/>
                <Separator/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Предыдущая страница"
                        Click="PreviousPage_Click" Content="❮"/>
                <TextBox x:Name="PageNumberBox" Width="55" Height="30"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Text="0" KeyDown="PageNumberBox_KeyDown"/>
                <TextBlock x:Name="PageCountText" Text="/ 0" Margin="5,0,10,0"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Следующая страница"
                        Click="NextPage_Click" Content="❯"/>
                <Separator/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Уменьшить"
                        Click="ZoomOut_Click" Content="−"/>
                <Slider x:Name="ZoomSlider" Width="130" Minimum="10" Maximum="400"
                        SmallChange="10" LargeChange="25" ValueChanged="ZoomSlider_ValueChanged"
                        ToolTip="Масштаб"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Увеличить"
                        Click="ZoomIn_Click" Content="+"/>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center"
                           VerticalAlignment="Center" Text="100%"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Вместить страницу"
                        Click="FitPage_Click" Content="⛶"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="По ширине"
                        Click="FitWidth_Click" Content="↔"/>
                <Separator/>
                <ComboBox x:Name="ViewModeCombo" Width="145" SelectionChanged="ViewModeCombo_SelectionChanged">
                    <ComboBoxItem Tag="Single" Content="Одна страница"/>
                    <ComboBoxItem Tag="Continuous" Content="Непрерывно"/>
                    <ComboBoxItem Tag="Facing" Content="Разворот"/>
                </ComboBox>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Повернуть"
                        Click="Rotate_Click" Content="↻"/>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Полный экран"
                        Click="FullScreen_Click" Content="⛶"/>
            </ToolBar>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <TabControl x:Name="SidebarTabs" BorderThickness="0">
                    <TabItem Header="Страницы">
                        <ListBox x:Name="ThumbnailList" Style="{StaticResource SidebarList}"
                                 SelectionChanged="ThumbnailList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8" Padding="7" CornerRadius="4"
                                            Background="{DynamicResource PanelAltBrush}"
                                            Loaded="ThumbnailItem_Loaded">
                                        <StackPanel>
                                            <Border Background="White" BorderBrush="#C8CCD2"
                                                    BorderThickness="1" MinHeight="120">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                           MaxHeight="210"/>
                                                    <TextBlock Text="Загрузка…" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#707780"
                                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                       Margin="0,6,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Закладки">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Margin="8" Content="+ Закладка на текущей странице"
                                    Click="ToggleBookmark_Click"/>
                            <ListBox x:Name="BookmarksList" Grid.Row="1" Style="{StaticResource SidebarList}"
                                     MouseDoubleClick="BookmarksList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="8,5">
                                            <TextBlock Text="🔖" Margin="0,0,8,0"/>
                                            <TextBlock Text="Страница "/>
                                            <TextBlock Text="{Binding}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="SearchTab" Header="Поиск">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Найти"
                                        Click="Search_Click"/>
                                <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown"
                                         ToolTip="Поиск по распознанному тексту"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,7,0,5">
                                <Button x:Name="CancelSearchButton" DockPanel.Dock="Right"
                                        Content="Отмена" Padding="6,2" Visibility="Collapsed"
                                        Click="CancelSearch_Click"/>
                                <TextBlock x:Name="SearchStatusText" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Введите текст для поиска"/>
                            </DockPanel>
                            <ListBox x:Name="SearchResultsList" Grid.Row="2"
                                     Style="{StaticResource SidebarList}"
                                     MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="7">
                                            <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap"
                                                       Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"/>

            <Grid x:Name="ViewerHost" Grid.Column="2" Background="{DynamicResource ViewerBrush}"
                  PreviewMouseWheel="ViewerHost_PreviewMouseWheel">
                <Grid x:Name="EmptyState">
                    <Border Width="440" Padding="40" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="#EFFFFFFF" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📖" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Откройте документ DjVu" FontSize="24"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,16,0,8" Foreground="#242830"/>
                            <TextBlock Text="Перетащите файл сюда или воспользуйтесь кнопкой"
                                       TextAlignment="Center" Foreground="#626B78"/>
                            <Button Content="Открыть файл…" Style="{StaticResource AccentButton}"
                                    Click="Open_Click" Width="160" Margin="0,22,0,0"/>
                            <TextBlock Text=".djvu  •  .djv" HorizontalAlignment="Center"
                                       Foreground="#7B8490" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SinglePageViewer" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <Border x:Name="SinglePageBorder" Background="White" Margin="32"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#14171A" BorderThickness="1">
                        <Grid x:Name="SinglePageSurface">
                            <Grid.LayoutTransform>
                                <RotateTransform x:Name="SingleRotateTransform"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="SinglePageImage" Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <local:SelectableTextLayer x:Name="SinglePageTextLayer"/>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <ListBox x:Name="ContinuousPagesList" Visibility="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="ContinuousPagesList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#14171A" BorderThickness="1"
                                    Margin="28,14" HorizontalAlignment="Center"
                                    Loaded="ContinuousPageItem_Loaded">
                                <Grid MinHeight="400" Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=PageDisplayWidth}">
                                    <Grid>
                                        <Grid.LayoutTransform>
                                            <RotateTransform Angle="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=PageRotation}"/>
                                        </Grid.LayoutTransform>
                                        <Image Source="{Binding Image}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <local:SelectableTextLayer PageText="{Binding TextLayer}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Страница " Foreground="#707780"/>
                                        <TextBlock Text="{Binding Label}" Foreground="#707780"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer x:Name="FacingPageViewer" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#14171A" BorderThickness="1">
                            <Grid x:Name="FacingLeftSurface">
                                <Grid.LayoutTransform>
                                    <RotateTransform x:Name="FacingLeftRotateTransform"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="FacingLeftImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <local:SelectableTextLayer x:Name="FacingLeftTextLayer"/>
                            </Grid>
                        </Border>
                        <Border x:Name="FacingRightBorder" Grid.Column="2" Background="White"
                                BorderBrush="#14171A" BorderThickness="1">
                            <Grid x:Name="FacingRightSurface">
                                <Grid.LayoutTransform>
                                    <RotateTransform x:Name="FacingRightRotateTransform"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="FacingRightImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <local:SelectableTextLayer x:Name="FacingRightTextLayer"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="BusyOverlay" Background="#990E1014" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="260" Height="5" IsIndeterminate="True"/>
                        <TextBlock x:Name="BusyText" Text="Открытие документа…"
                                   Foreground="White" FontSize="16" Margin="0,14,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="DropOverlay" Background="#D94F6BED" Visibility="Collapsed"
                        BorderBrush="White" BorderThickness="3" Margin="15" CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="72" HorizontalAlignment="Center"/>
                        <TextBlock Text="Отпустите файл, чтобы открыть" Foreground="White"
                                   FontSize="25" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StatusBar x:Name="MainStatusBar" Grid.Row="3" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="FileStatusText" Text="Документ не открыт"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ModeStatusText" Text="Одна страница"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomStatusText" Text="100%"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
